# Quiz Platform - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# LLM API Keys (at least one required)
# ===========================================
# Get Gemini API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# LLM Provider: auto, gemini, openai
LLM_PROVIDER=auto

# Model (optional, uses provider defaults)
# For Gemini: gemini-1.5-flash, gemini-1.5-pro
# For OpenAI: gpt-4o-mini, gpt-4o
LLM_MODEL=

# ===========================================
# Application Settings
# ===========================================
# Cache TTL in seconds (default: 1 hour)
CACHE_TTL_SECONDS=3600

# Maximum cache entries (default: 100)
CACHE_MAX_SIZE=100

# Rate limit per minute per IP (default: 10)
RATE_LIMIT_PER_MINUTE=10

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# CORS Origins - comma-separated list
# For Tailscale Funnel: https://your-tailnet.ts.net
# For Cloudflare Tunnel: https://your-domain.com
# For local dev: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=*

# ===========================================
# Deployment URLs (for reference)
# ===========================================
# Tailscale Funnel URL (after running: tailscale funnel 443)
# TAILSCALE_FUNNEL_URL=https://your-device.your-tailnet.ts.net

# Cloudflare Tunnel URL
# CLOUDFLARE_TUNNEL_URL=https://quiz.your-domain.com